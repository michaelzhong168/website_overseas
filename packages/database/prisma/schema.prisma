generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         UserRole @default(EDITOR)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum UserRole {
  ADMIN
  EDITOR
}

model Page {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  body         String   @default("")
  heroImageUrl String   @default("")
  locale       String   @default("en")
  published    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Product {
  id          String   @id @default(cuid())
  slug        String
  title       String
  summary     String   @default("")
  description String   @default("")
  imageUrl    String   @default("")
  locale      String   @default("en")
  published   Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([slug, locale])
}

model NewsPost {
  id          String   @id @default(cuid())
  slug        String
  title       String
  excerpt     String   @default("")
  body        String   @default("")
  coverUrl    String   @default("")
  locale      String   @default("en")
  published   Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([slug, locale])
}

model FormSubmission {
  id        String   @id @default(cuid())
  formType  String
  payload   Json
  createdAt DateTime @default(now())
}

model Project {
  id        String   @id @default(cuid())
  slug      String
  title     String
  subtitle  String   @default("")
  location  String   @default("")
  coverUrl  String   @default("")
  body      String   @default("")
  locale    String   @default("en")
  published Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([slug, locale])
}

model StoreLocation {
  id        String   @id @default(cuid())
  slug      String
  name      String
  city      String   @default("")
  country   String   @default("")
  address   String   @default("")
  phone     String   @default("")
  hoursNote String   @default("")
  mapUrl    String   @default("")
  locale    String   @default("en")
  published Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([slug, locale])
}
